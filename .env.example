# GEMINI_API_KEY: Backend-only environment variable for Google Gemini API calls.
# Loaded exclusively in the Python FastAPI backend via python-dotenv and os.getenv("GEMINI_API_KEY").
# Never prefix this variable with VITE_ and never expose it in frontend code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Configurable base URL for the Python FastAPI backend.
# Leave empty or set to http://localhost:8000 for local development.
# When the backend is unreachable, the React frontend automatically falls back to the built-in synthetic dataset.
VITE_API_BASE_URL="http://localhost:8000"

# FastAPI Backend Runtime Configuration (Placeholders Only — No Secrets)
APP_ENV="development"
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8000"
SQLITE_DB_PATH="backend/studentsuccess.db"

# Firebase Admin SDK Configuration (Server-Side Token Verification)
# Provisioned Firebase Project ID (matches firebase-applet-config.json)
FIREBASE_PROJECT_ID="electric-coder-3vd6f"
# Optional path to Firebase Admin service account JSON file (keep outside Git)
FIREBASE_SERVICE_ACCOUNT_PATH=""

# ALLOWED_ORIGINS: Comma-separated list of explicit CORS origins allowed to call FastAPI.
# Never set to "*" in production.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

